{
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "build"],
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2024"],
    "types": ["node"],

    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,

    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,

    "esModuleInterop": true,
    "noUncheckedSideEffectImports": true
  }
}
